# Database Configuration
# These defaults match the Postgres that `docker compose up -d` starts locally.
# Use a real password and database for any shared or production deployment.
DB_DRIVER=postgresql+psycopg
DB_USER=postgres
DB_PASS=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=postgres

# Service URLs
SERVICE_PROMPTS=

# Prompt Storage Backend: "postgres" (default), "langsmith", or "service"
# "service" needs SERVICE_PROMPTS set to an external prompts service URL.
PROMPT_STORAGE_BACKEND=postgres

# =============================================================================
# API KEYS
# =============================================================================
# At least one model provider API key is required
GOOGLE_API_KEY=your-google-api-key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
ZAI_API_KEY=
DEEPSEEK_API_KEY=

# Model used when a chat request doesn't set "model".
# Accepts a pinned id or a latest-of-a-tier alias, e.g. anthropic:sonnet-latest.
# Falls back to gemini-3-flash-preview when unset.
# DEFAULT_CHAT_MODEL=gemini-3-flash-preview

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Admin secret for /admin/* endpoints (required in production)
ADMIN_SECRET=your-admin-secret

# Fernet encryption key for token data (auto-generated if missing)
SECRET_TOKEN_ENC_KEY=

# Set to "true" to disable all authentication. Local development only:
# never enable this on a deployment other people can reach.
# AUTH_DISABLED=true

# =============================================================================
# GUARDRAILS
# =============================================================================
# Enable prompt injection detection and PII masking
ENABLE_GUARDRAILS=false

# =============================================================================
# VECTOR DATABASE
# =============================================================================
QDRANT_URL=http://127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=

# ============================================================
# BRIGHT DATA
# ============================================================
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_WEB_UNLOCKER_ZONE=web_unlocker1
BRIGHT_DATA_SERP_ZONE=serp_api1

# =============================================================================
# OBSERVABILITY CONFIGURATION
# =============================================================================
OTEL_SERVICE_NAME=hivegate
OTEL_SERVICE_VERSION=1.0.0
OTEL_ENVIRONMENT=development

# Tracing Backend (choose one: none, console, otlp, jaeger, sentry)
OTEL_TRACING_BACKEND=console
OTEL_TRACING_SAMPLE_RATE=1.0

# Logging Backend (comma-separated: console, otlp, logtail)
OTEL_LOGGING_BACKEND=console
OTEL_LOG_LEVEL=INFO

# OTLP Collector (for 'otlp' backend)
# OTEL_OTLP_ENDPOINT=http://localhost:4317
# OTEL_OTLP_INSECURE=true

# Jaeger (for 'jaeger' backend)
# OTEL_JAEGER_AGENT_HOST=localhost
# OTEL_JAEGER_AGENT_PORT=6831

# Legacy: Better Stack/Logtail (for 'logtail' logging backend)
# BETTERSTACK_SOURCE_TOKEN=your-token-here
# BETTERSTACK_HOST=

# Legacy: Sentry (for 'sentry' tracing backend)
# SENTRY_DSN=https://your-dsn@sentry.io/xxx

# =============================================================================
# MISC
# =============================================================================
ENVIRONMENT=development
TESTING=false
AGENT_DEBUG_MODE=false
DOCS_ENABLED=true
CORS_ORIGIN_LIST=
CONCURRENT_FUTURES_TIMEOUT=180

